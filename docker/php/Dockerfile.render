FROM php:8.4-fpm

# ============================================================
# Dependencias del sistema
# ============================================================

RUN apt-get update && apt-get install -y \
    git \
    curl \
    unzip \
    nginx \
    supervisor \
    libzip-dev \
    libpng-dev \
    libjpeg62-turbo-dev \
    libfreetype6-dev \
    libonig-dev \
    libxml2-dev \
    libicu-dev \
    libpq-dev \
    && docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install \
        pdo_pgsql \
        mbstring \
        exif \
        pcntl \
        bcmath \
        gd \
        intl \
        zip \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# ============================================================
# Composer
# ============================================================

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

# ============================================================
# Node.js 22
# ============================================================

RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y nodejs \
    && npm install -g npm@latest \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# ============================================================
# Directorio de trabajo
# ============================================================

WORKDIR /var/www

# ============================================================
# Composer
# Copiamos primero los archivos necesarios para aprovechar
# la caché de Docker.
# ============================================================

COPY composer.json composer.lock ./

# Laravel necesita estos archivos/directorios durante
# los scripts de Composer.
COPY artisan ./
COPY app ./app
COPY bootstrap ./bootstrap
COPY config ./config
COPY database ./database
COPY lang ./lang
COPY routes ./routes

# ============================================================
# Directorios necesarios para Laravel
# ============================================================

RUN mkdir -p \
    storage/framework/cache \
    storage/framework/sessions \
    storage/framework/views \
    storage/logs \
    bootstrap/cache

# ============================================================
# Dependencias PHP
# ============================================================

RUN composer install \
    --no-dev \
    --no-interaction \
    --prefer-dist \
    --optimize-autoloader

# ============================================================
# Dependencias frontend
# ============================================================

COPY package.json package-lock.json ./

RUN npm ci

# ============================================================
# Copiamos el resto de la aplicación
# ============================================================

COPY . .

# ============================================================
# Assets de producción
# ============================================================

RUN rm -rf public/build \
    && npm run build \
    && echo "===== DASHBOARD EN MANIFEST =====" \
    && grep -n "resources/css/dashboard.css" public/build/manifest.json \
    && echo "===== ARCHIVO DASHBOARD =====" \
    && find public/build/assets -type f -name "*dashboard*"

# ============================================================
# Configuración Nginx
# ============================================================

RUN rm -f /etc/nginx/conf.d/default.conf

COPY docker/nginx/default.render.conf /etc/nginx/conf.d/default.conf

# ============================================================
# Configuración Supervisor
# ============================================================

COPY docker/supervisor/supervisord.conf \
    /etc/supervisor/conf.d/supervisord.conf

# ============================================================
# Permisos Laravel
# ============================================================

RUN chown -R www-data:www-data \
    storage \
    bootstrap/cache

# ============================================================
# Entrypoint
# ============================================================

COPY docker/php/entrypoint.render.sh \
    /usr/local/bin/entrypoint.render.sh

RUN chmod +x /usr/local/bin/entrypoint.render.sh

# ============================================================
# Puerto
# ============================================================

EXPOSE 10000

# ============================================================
# Arranque
# ============================================================

ENTRYPOINT ["entrypoint.render.sh"]

CMD ["supervisord", "-c", "/etc/supervisor/conf.d/supervisord.conf"]
